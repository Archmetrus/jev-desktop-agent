{
  "provider": "opencode",
  "laya": {
    "threshold": 0.65
  },
  "model": "jev-latest",
  "confidence_threshold": 0.8,
  "probability_threshold": 0.8,
  "request_timeout": 15,
  "window_timeout": 10,
  "max_steps": 20,
  "max_task_seconds": 90,
  "max_no_progress": 3,
  "speech": {
    "binary": ".local/whisper.cpp/build/bin/whisper-cli",
    "model": ".local/models/ggml-base.en.bin",
    "shortcut": "CTRL+ALT+v",
    "denoise": true,
    "indicator": true,
    "vocabulary": [
      "Jev",
      "Firefox",
      "Google Chrome",
      "YouTube",
      "Konsole",
      "Dolphin",
      "browser",
      "terminal",
      "pause music",
      "next track",
      "switch tab",
      "click number",
      "maximize window",
      "volume"
    ],
    "energy_threshold": 0.004,
    "silence_seconds": 1.3,
    "max_record_seconds": 20
  }
}
